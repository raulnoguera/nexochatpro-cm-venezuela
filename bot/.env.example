# Copia este archivo a .env y llena los valores. NUNCA subas el .env real.
PORT=4001
BUSINESS_NAME="CM Venezuela"

# ---- Chatwoot ----
CHATWOOT_URL=https://crm.tu-dominio.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_TOKEN=            # token de acceso del usuario "Nexo" (agente) en Chatwoot

# ---- Modelo (Gemini, API nativa) ----
LLM_API_KEY=               # clave de Google AI Studio
LLM_MODEL=gemini-3-flash-preview
LLM_FALLBACK_MODEL=gemini-flash-lite-latest
LLM_PENSAR=low             # razonamiento: minimal | low | medium | high (vacío = el de Google)
# LLM_CACHE=0              # 0 desactiva la caché explícita de instrucciones

# ---- Bandejas que atiende Nexo ----
BOT_INBOX_IDS=1,2          # ids de bandejas de Chatwoot donde Nexo responde
BOT_PRUEBA_INBOX_IDS=      # bandejas "en prueba": Nexo solo responde si la conversación tiene la etiqueta "prueba"...
BOT_PRUEBA_CONTACT_IDS=    # ...o si el contacto está en esta lista
SEGUIMIENTO_MINUTOS=120    # recordatorio a quien dejó la conversación a medias

# ---- Tasas de respaldo (si falla ve.dolarapi.com) ----
FALLBACK_RATE_EUR=
FALLBACK_RATE_USD=

# ---- Panel de administración (/admin) ----
LISTA_CLAVE=               # clave de acceso; sin ella el panel no existe (responde 404)
# PUBLIC_URL=https://crm.tu-dominio.com

# ---- Facebook / Instagram (ver docs/META.md) ----
META_APP_SECRET=
META_VERIFY_TOKEN=         # cadena que eliges; se registra igual en Meta
META_PAGE_ID=
META_PAGE_TOKEN=           # token permanente de la página
# META_IG_ID=
META_MARCA="Master Cauchos"   # nombre que firma el mensaje privado de comentarios
META_MODO=                 # vacío = prueba (solo responde comentarios con #prueba); "produccion" = responde a todos
# META_CLAVE_PRUEBA=#prueba
# META_DRY_RUN=1           # solo registra lo que haría, sin llamar a Meta
