# Entorno de Chatwoot en el servidor. Copia a .env y llena los valores. NUNCA subas el .env real.
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
SECRET_KEY_BASE=           # openssl rand -hex 64
FRONTEND_URL=https://crm.tu-dominio.com
FORCE_SSL=true
DEFAULT_LOCALE=es
ENABLE_ACCOUNT_SIGNUP=false
LOG_LEVEL=info
RAILS_LOG_TO_STDOUT=true

POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=         # también lo usa docker-compose.yml
REDIS_URL=redis://redis:6379

# Canal de Messenger (misma app de Meta que usa el bot). Ojo: Chatwoot guarda estos valores en su base de datos
# (tabla installation_configs) y esa copia manda sobre el entorno. Ver docs/META.md.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
